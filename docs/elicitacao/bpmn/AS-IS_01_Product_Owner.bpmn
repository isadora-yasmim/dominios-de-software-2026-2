<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="AS-IS 1 · Feedback e avaliação segundo a Product Owner (Entrevista 01)" processRef="Process_1" />
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_RH" name="RH">
        <flowNodeRef>r_start</flowNodeRef>
        <flowNodeRef>r_train</flowNodeRef>
        <flowNodeRef>r_end1</flowNodeRef>
        <flowNodeRef>r_start2</flowNodeRef>
        <flowNodeRef>r_hist</flowNodeRef>
        <flowNodeRef>r_end2</flowNodeRef>
      </lane>
      <lane id="Lane_Gestor" name="Gestor">
        <flowNodeRef>g_startF</flowNodeRef>
        <flowNodeRef>g_plan</flowNodeRef>
        <flowNodeRef>g_par1</flowNodeRef>
        <flowNodeRef>g_coleta</flowNodeRef>
        <flowNodeRef>g_par2</flowNodeRef>
        <flowNodeRef>g_agenda</flowNodeRef>
        <flowNodeRef>g_xor1</flowNodeRef>
        <flowNodeRef>g_startI</flowNodeRef>
        <flowNodeRef>g_fato</flowNodeRef>
        <flowNodeRef>g_sessao</flowNodeRef>
        <flowNodeRef>g_regis</flowNodeRef>
        <flowNodeRef>g_xor2</flowNodeRef>
        <flowNodeRef>g_plano</flowNodeRef>
        <flowNodeRef>g_monit</flowNodeRef>
        <flowNodeRef>g_xor3</flowNodeRef>
        <flowNodeRef>g_end</flowNodeRef>
      </lane>
      <lane id="Lane_Colab" name="Colaborador">
        <flowNodeRef>c_auto</flowNodeRef>
        <flowNodeRef>c_sessao</flowNodeRef>
      </lane>
      <lane id="Lane_Pares" name="Pares">
        <flowNodeRef>p_360</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="r_start" name="Implantação do processo" />
    <task id="r_train" name="Treinar quem dá e quem recebe feedback" />
    <endEvent id="r_end1" name="Equipe preparada" />
    <startEvent id="r_start2" name="Decisão sobre a pessoa (ex.: promoção)" />
    <task id="r_hist" name="Consultar o histórico de feedbacks" />
    <endEvent id="r_end2" name="Decisão fundamentada" />
    <startEvent id="g_startF" name="Ciclo formal planejado" />
    <task id="g_plan" name="Planejar objetivos, competências e indicadores" />
    <parallelGateway id="g_par1" name="" />
    <task id="g_coleta" name="Coletar fatos e fazer os check-ins" />
    <parallelGateway id="g_par2" name="" />
    <task id="g_agenda" name="Agendar a sessão de feedback" />
    <exclusiveGateway id="g_xor1" name="" />
    <startEvent id="g_startI" name="Fato observado no dia a dia" />
    <task id="g_fato" name="Coletar o fato e decidir dar o feedback" />
    <task id="g_sessao" name="Conduzir o feedback (positivo ou construtivo)" />
    <task id="g_regis" name="Registrar o feedback e avaliar a sessão" />
    <exclusiveGateway id="g_xor2" name="Feedback construtivo?" />
    <task id="g_plano" name="Construir o plano de ação com o colaborador" />
    <task id="g_monit" name="Monitorar o plano nos check-ins" />
    <exclusiveGateway id="g_xor3" name="Melhorou até a data final?" />
    <endEvent id="g_end" name="Feedback encerrado" />
    <task id="c_auto" name="Fazer a autoavaliação" />
    <task id="c_sessao" name="Receber o feedback e refletir" />
    <task id="p_360" name="Avaliar o colega no 360º" />
    <sequenceFlow id="Flow_1" sourceRef="r_start" targetRef="r_train" />
    <sequenceFlow id="Flow_2" sourceRef="r_train" targetRef="r_end1" />
    <sequenceFlow id="Flow_3" sourceRef="r_start2" targetRef="r_hist" />
    <sequenceFlow id="Flow_4" sourceRef="r_hist" targetRef="r_end2" />
    <sequenceFlow id="Flow_5" sourceRef="g_startF" targetRef="g_plan" />
    <sequenceFlow id="Flow_6" sourceRef="g_plan" targetRef="g_par1" />
    <sequenceFlow id="Flow_7" sourceRef="g_par1" targetRef="g_coleta" />
    <sequenceFlow id="Flow_8" sourceRef="g_par1" targetRef="c_auto" />
    <sequenceFlow id="Flow_9" sourceRef="g_par1" targetRef="p_360" />
    <sequenceFlow id="Flow_10" sourceRef="g_coleta" targetRef="g_par2" />
    <sequenceFlow id="Flow_11" sourceRef="c_auto" targetRef="g_par2" />
    <sequenceFlow id="Flow_12" sourceRef="p_360" targetRef="g_par2" />
    <sequenceFlow id="Flow_13" sourceRef="g_par2" targetRef="g_agenda" />
    <sequenceFlow id="Flow_14" sourceRef="g_agenda" targetRef="g_xor1" />
    <sequenceFlow id="Flow_15" sourceRef="g_startI" targetRef="g_fato" />
    <sequenceFlow id="Flow_16" sourceRef="g_fato" targetRef="g_xor1" />
    <sequenceFlow id="Flow_17" sourceRef="g_xor1" targetRef="g_sessao" />
    <sequenceFlow id="Flow_18" sourceRef="g_sessao" targetRef="c_sessao" />
    <sequenceFlow id="Flow_19" sourceRef="c_sessao" targetRef="g_regis" />
    <sequenceFlow id="Flow_20" sourceRef="g_regis" targetRef="g_xor2" />
    <sequenceFlow id="Flow_21" sourceRef="g_xor2" targetRef="g_plano" name="Sim" />
    <sequenceFlow id="Flow_22" sourceRef="g_xor2" targetRef="g_end" name="Não (positivo)" />
    <sequenceFlow id="Flow_23" sourceRef="g_plano" targetRef="g_monit" />
    <sequenceFlow id="Flow_24" sourceRef="g_monit" targetRef="g_xor3" />
    <sequenceFlow id="Flow_25" sourceRef="g_xor3" targetRef="g_end" name="Sim" />
    <sequenceFlow id="Flow_26" sourceRef="g_xor3" targetRef="g_sessao" name="Não: nova rodada" />
    <textAnnotation id="Ann_1"><text>D2 · Planejar e acompanhar cada pessoa dá trabalho e falta tempo</text></textAnnotation>
    <association id="Assoc_Ann_1" sourceRef="Ann_1" targetRef="g_plan" associationDirection="None" />
    <textAnnotation id="Ann_2"><text>D3 · Reação defensiva: o feedback é visto como crítica</text></textAnnotation>
    <association id="Assoc_Ann_2" sourceRef="Ann_2" targetRef="c_sessao" associationDirection="None" />
    <textAnnotation id="Ann_3"><text>D6 · Participação dos avaliadores no 360º não é garantida</text></textAnnotation>
    <association id="Assoc_Ann_3" sourceRef="Ann_3" targetRef="p_360" associationDirection="None" />
    <textAnnotation id="Ann_4"><text>D5 · Feedback mal dado: pouco elogio e crítica agressiva</text></textAnnotation>
    <association id="Assoc_Ann_4" sourceRef="Ann_4" targetRef="g_sessao" associationDirection="None" />
    <textAnnotation id="Ann_5"><text>D1 · Registro manual (papel, Excel) e informação que se perde</text></textAnnotation>
    <association id="Assoc_Ann_5" sourceRef="Ann_5" targetRef="g_regis" associationDirection="None" />
    <textAnnotation id="Ann_6"><text>D4 · Sem controle se a pessoa melhorou</text></textAnnotation>
    <association id="Assoc_Ann_6" sourceRef="Ann_6" targetRef="g_xor3" associationDirection="None" />
    <textAnnotation id="Ann_7"><text>D1 · O feedback informal fica só na conversa</text></textAnnotation>
    <association id="Assoc_Ann_7" sourceRef="Ann_7" targetRef="g_fato" associationDirection="None" />
    <textAnnotation id="Legend_1"><text>DORES IDENTIFICADAS (fonte: Entrevista 01, com a Product Owner)
D1  Registro manual (papel, Excel): o feedback, sobretudo o informal, se perde (seções 6 e 18)
D2  Planejar e acompanhar cada pessoa dá muito trabalho e o gestor tem pouco tempo (seção 9)
D3  Reação defensiva: o feedback é visto como crítica destrutiva (seções 13, 20 e 22)
D4  Sem controle se a pessoa melhorou depois do feedback (seção 6)
D5  Feedback mal dado: pouco elogio e crítica agressiva (seção 20)
D6  No 360º, a participação dos avaliadores não é garantida (seção 21)</text></textAnnotation>
  </process>
