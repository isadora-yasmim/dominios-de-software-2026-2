<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="AS-IS 2 · Feedback na Secretaria Municipal de Educação (Entrevista 02)" processRef="Process_1" />
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_RH" name="RH">
      </lane>
      <lane id="Lane_Gestor" name="Gestor (Secretária)">
        <flowNodeRef>g_startA</flowNodeRef>
        <flowNodeRef>g_confirma</flowNodeRef>
        <flowNodeRef>g_anota</flowNodeRef>
        <flowNodeRef>g_hor</flowNodeRef>
        <flowNodeRef>g_chama</flowNodeRef>
        <flowNodeRef>g_xorM</flowNodeRef>
        <flowNodeRef>g_combina</flowNodeRef>
        <flowNodeRef>g_acomp</flowNodeRef>
        <flowNodeRef>g_end</flowNodeRef>
        <flowNodeRef>g_startB</flowNodeRef>
        <flowNodeRef>g_elogio</flowNodeRef>
        <flowNodeRef>g_endB</flowNodeRef>
        <flowNodeRef>g_endNo</flowNodeRef>
      </lane>
      <lane id="Lane_Colab" name="Colaborador (Servidor)">
        <flowNodeRef>c_ouve</flowNodeRef>
        <flowNodeRef>c_xor</flowNodeRef>
        <flowNodeRef>c_just</flowNodeRef>
      </lane>
      <lane id="Lane_Pares" name="Pares (Colegas)">
        <flowNodeRef>p_start</flowNodeRef>
        <flowNodeRef>p_avisa</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="p_start" name="Colega percebe um problema" />
    <task id="p_avisa" name="Avisar a secretária e pedir que converse com a pessoa" />
    <startEvent id="g_startA" name="Secretária percebe um problema" />
    <task id="g_confirma" name="Confirmar o fato por conta própria" />
    <task id="g_anota" name="Anotar no caderninho (nem sempre)" />
    <exclusiveGateway id="g_hor" name="Há horário em comum?" />
    <task id="g_chama" name="Chamar a pessoa no particular, no fim do expediente" />
    <exclusiveGateway id="g_xorM" name="" />
    <task id="g_combina" name="Combinar a melhoria de forma verbal" />
    <task id="g_acomp" name="Acompanhar de modo informal, pelas anotações" />
    <endEvent id="g_end" name="Sem registro formal" />
    <startEvent id="g_startB" name="Trabalho muito bom percebido" />
    <task id="g_elogio" name="Enviar o elogio por mensagem (WhatsApp)" />
    <endEvent id="g_endB" name="Elogio informal, sem registro" />
    <endEvent id="g_endNo" name="Feedback passa batido" />
    <task id="c_ouve" name="Ouvir a conversa e responder" />
    <exclusiveGateway id="c_xor" name="Concorda?" />
    <task id="c_just" name="Justificar e discordar (vira discussão)" />
    <sequenceFlow id="Flow_1" sourceRef="p_start" targetRef="p_avisa" />
    <sequenceFlow id="Flow_2" sourceRef="p_avisa" targetRef="g_confirma" />
    <sequenceFlow id="Flow_3" sourceRef="g_startA" targetRef="g_confirma" />
    <sequenceFlow id="Flow_4" sourceRef="g_confirma" targetRef="g_anota" />
    <sequenceFlow id="Flow_5" sourceRef="g_anota" targetRef="g_hor" />
    <sequenceFlow id="Flow_6" sourceRef="g_hor" targetRef="g_chama" name="Sim" />
    <sequenceFlow id="Flow_7" sourceRef="g_hor" targetRef="g_endNo" name="Não" />
    <sequenceFlow id="Flow_8" sourceRef="g_chama" targetRef="c_ouve" />
    <sequenceFlow id="Flow_9" sourceRef="c_ouve" targetRef="c_xor" />
    <sequenceFlow id="Flow_10" sourceRef="c_xor" targetRef="g_xorM" name="Sim" />
    <sequenceFlow id="Flow_11" sourceRef="c_xor" targetRef="c_just" name="Não" />
    <sequenceFlow id="Flow_12" sourceRef="c_just" targetRef="g_xorM" />
    <sequenceFlow id="Flow_13" sourceRef="g_xorM" targetRef="g_combina" />
    <sequenceFlow id="Flow_14" sourceRef="g_combina" targetRef="g_acomp" />
    <sequenceFlow id="Flow_15" sourceRef="g_acomp" targetRef="g_end" />
    <sequenceFlow id="Flow_16" sourceRef="g_startB" targetRef="g_elogio" />
    <sequenceFlow id="Flow_17" sourceRef="g_elogio" targetRef="g_endB" />
    <textAnnotation id="Ann_1"><text>D5 · Quem reclama fica anônimo só pela discrição da secretária</text></textAnnotation>
    <association id="Assoc_Ann_1" sourceRef="Ann_1" targetRef="p_avisa" associationDirection="None" />
    <textAnnotation id="Ann_2"><text>D6 · Sem formulário nem indicadores: avaliação pela percepção</text></textAnnotation>
    <association id="Assoc_Ann_2" sourceRef="Ann_2" targetRef="g_confirma" associationDirection="None" />
    <textAnnotation id="Ann_3"><text>D1 · Sem registro: tudo de boca, caderninho só às vezes</text></textAnnotation>
    <association id="Assoc_Ann_3" sourceRef="Ann_3" targetRef="g_anota" associationDirection="None" />
    <textAnnotation id="Ann_4"><text>D2 · Agendas não coincidem e o feedback passa batido</text></textAnnotation>
    <association id="Assoc_Ann_4" sourceRef="Ann_4" targetRef="g_hor" associationDirection="None" />
    <textAnnotation id="Ann_5"><text>D4 · Acompanhamento depende da memória e do caderninho</text></textAnnotation>
    <association id="Assoc_Ann_5" sourceRef="Ann_5" targetRef="g_acomp" associationDirection="None" />
    <textAnnotation id="Ann_6"><text>D3 · A pessoa se justifica e vira discussão</text></textAnnotation>
    <association id="Assoc_Ann_6" sourceRef="Ann_6" targetRef="c_just" associationDirection="None" />
    <textAnnotation id="Ann_7"><text>O RH não participa deste processo: a secretária responde ao prefeito.</text></textAnnotation>
    <textAnnotation id="Ann_8"><text>Estágio probatório: segue a regra do órgão responsável pelo cargo (fora deste fluxo).</text></textAnnotation>
    <textAnnotation id="Legend_1"><text>DORES IDENTIFICADAS (fonte: Entrevista 02, com a Secretária Municipal de Educação)
D1  Sem registro: tudo é conversa e o caderninho só é usado às vezes (seções 2, 3 e 4)
D2  As agendas não coincidem, o feedback passa batido e há muitas demandas (seções 2 e 8)
D3  Quem recebe se justifica e a conversa vira discussão (seção 2)
D4  O acompanhamento é informal e depende da memória e do caderninho (seção 4)
D5  Quem reclama fica anônimo só pela discrição da secretária (seções 3 e 6)
D6  Sem formulário nem indicadores: a avaliação é pela percepção (seção 5)</text></textAnnotation>
  </process>
